---
import Sticker from '../ui/Sticker.astro';

const reviews = [
  {
    rotate: -3,
    quote:
      'Me explicaron cada paso y el polarizado quedó impecable. Buen trato, tiempo respetado y un acabado que se nota.',
    author: 'CLIENTE DE POLARIZADO',
  },
  {
    rotate: 2,
    quote:
      'El wrap quedó exactamente como lo imaginé. Trabajo limpio, materiales de calidad y cero sorpresas.',
    author: 'CLIENTE DE FULL WRAP',
  },
  {
    rotate: -1.5,
    quote:
      'Llevé mi moto por accesorios y estética. Quedó como nueva y el taller se siente de otro nivel.',
    author: 'CLIENTE DE MOTO',
  },
];
---

<section
  id="testimonios"
  class="section section--alt testimonials"
  aria-labelledby="testimonios-title"
>
  <div class="container">
    <div class="section-head neon-ignite" data-reveal>
      <p class="eyebrow">VOCES // MUESTRA</p>
      <h2 id="testimonios-title">LO QUE DICE LA CALLE</h2>
      <p>
        Reseñas de muestra para mostrar el tono. Antes de publicar se sustituyen
        por reseñas reales de clientes.
      </p>
    </div>

    <!-- TODO: reemplazar estas reseñas de muestra por reseñas reales autorizadas -->
    <ul class="testimonials__grid">
      {reviews.map((review) => (
        <li>
          <Sticker rotate={review.rotate}>
            <p class="testimonial__tag mono">RESEÑA DE MUESTRA</p>
            <blockquote class="testimonial__quote">
              {review.quote}
            </blockquote>
            <footer class="testimonial__author mono">
              {review.author} // EJEMPLO
            </footer>
          </Sticker>
        </li>
      ))}
    </ul>

    <p class="testimonials__note mono">
      EJEMPLOS DE DISEÑO // REEMPLAZAR CON RESEÑAS REALES ANTES DE PUBLICAR
    </p>
  </div>
</section>

<style>
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(var(--space-4), 3vw, var(--space-8));
  }

  .testimonial__tag {
    margin: 0 0 var(--space-3);
    color: var(--neon-acid);
    font-size: 0.6rem;
  }

  .testimonial__quote {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.5;
  }

  .testimonial__author {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--line-strong);
    color: var(--text-dim);
    font-size: 0.6rem;
  }

  .testimonials__note {
    margin-top: var(--space-8);
    color: var(--neon-orange);
    font-size: 0.62rem;
  }

  @media (max-width: 767px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding-inline: var(--space-2);
    }
  }
</style>
