---
const works = [
  { title: 'Full wrap neón', size: 'wide' },
  { title: 'Polarizado lateral', size: 'normal' },
  { title: 'Faros pulidos', size: 'normal' },
  { title: 'Calcomanía custom', size: 'tall' },
  { title: 'Detalle de moto', size: 'normal' },
  { title: 'Iluminación interior', size: 'wide' },
];
---

<section id="galeria" class="section gallery" aria-labelledby="galeria-title">
  <div class="container">
    <div class="section-head neon-ignite" data-reveal>
      <p class="eyebrow">GALERÍA // MURO</p>
      <h2 id="galeria-title">EL MURO DE LOS TRABAJOS</h2>
      <p>
        Aquí van los trabajos reales. Por ahora, placeholders honestos: nada de
        fotos de stock ni portafolios inventados.
      </p>
    </div>

    <!-- TODO: reemplazar placeholders con fotos reales de trabajos -->
    <ul class="gallery__grid">
      {works.map((work) => (
        <li class:list={['gallery__item', `gallery__item--${work.size}`]}>
          <button
            class="gallery__button"
            type="button"
            data-gallery-item
            data-gallery-title={work.title}
          >
            <span class="gallery__visual" aria-hidden="true">
              <span class="gallery__spray"></span>
              <span class="gallery__tag mono">PLACEHOLDER</span>
            </span>
            <span class="gallery__caption">
              <span class="mono">PENDIENTE</span>
              <strong>{work.title}</strong>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <p class="gallery__note mono">
      TODO: REEMPLAZAR // FOTOS REALES PENDIENTES
    </p>
  </div>

  <div class="lightbox" data-lightbox hidden>
    <div class="lightbox__dialog" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
      <button
        class="lightbox__close"
        type="button"
        data-lightbox-close
        aria-label="Cerrar galería"
      >
        <span aria-hidden="true">x</span>
      </button>

      <div class="lightbox__visual" data-lightbox-visual aria-hidden="true">
        PLACEHOLDER
      </div>

      <h3 id="lightbox-title" data-lightbox-title>Trabajo en proceso</h3>

      <div class="lightbox__nav">
        <button type="button" data-lightbox-prev>Anterior</button>
        <button type="button" data-lightbox-next>Siguiente</button>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/lightbox';
</script>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 10rem;
    grid-auto-flow: dense;
    gap: var(--space-3);
  }

  .gallery__item--wide {
    grid-column: span 2;
  }

  .gallery__item--tall {
    grid-row: span 2;
  }

  .gallery__button {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
    text-align: left;
    clip-path: var(--clip-corner-sm);
    transition:
      border-color var(--dur-fast),
      box-shadow var(--dur-fast);
  }

  .gallery__button:hover,
  .gallery__button:focus-visible {
    border-color: var(--neon-magenta);
    box-shadow: 0 0 22px color-mix(in srgb, var(--neon-magenta) 28%, transparent);
  }

  .gallery__visual {
    position: relative;
    display: grid;
    place-items: center;
    flex: 1;
    min-height: 6rem;
    background:
      repeating-linear-gradient(
        125deg,
        transparent 0 14px,
        color-mix(in srgb, var(--line) 55%, transparent) 14px 15px
      ),
      radial-gradient(circle at 70% 30%, var(--bg-wall), var(--bg));
  }

  .gallery__spray {
    position: absolute;
    width: 55%;
    height: 55%;
    border: 1px dashed color-mix(in srgb, var(--neon-cyan) 45%, transparent);
    transform: rotate(-8deg);
  }

  .gallery__tag {
    position: relative;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    color: var(--neon-acid);
    font-size: 0.58rem;
  }

  .gallery__caption {
    display: grid;
    gap: 0.1rem;
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--line);
  }

  .gallery__caption .mono {
    color: var(--text-dim);
    font-size: 0.55rem;
  }

  .gallery__caption strong {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .gallery__note {
    margin-top: var(--space-4);
    color: var(--text-dim);
    font-size: 0.62rem;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: grid;
    place-items: center;
    padding: var(--space-4);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__dialog {
    position: relative;
    width: min(100%, 46rem);
    padding: var(--space-6);
    border: 1px solid var(--neon-magenta);
    background: var(--bg-raised);
    box-shadow: var(--glow-box-magenta);
    clip-path: var(--clip-corner);
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1rem;
    text-transform: uppercase;
  }

  .lightbox__close:hover,
  .lightbox__close:focus-visible {
    border-color: var(--neon-magenta);
    color: var(--neon-magenta);
  }

  .lightbox__visual {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-4);
    border: 1px dashed var(--line-strong);
    background:
      repeating-linear-gradient(
        125deg,
        transparent 0 18px,
        color-mix(in srgb, var(--line) 55%, transparent) 18px 19px
      ),
      var(--bg);
    color: var(--neon-acid);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }

  .lightbox__dialog h3 {
    font-size: var(--fs-h3);
  }

  .lightbox__nav {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .lightbox__nav button {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .lightbox__nav button:hover,
  .lightbox__nav button:focus-visible {
    border-color: var(--neon-cyan);
    color: var(--neon-cyan);
  }

  @media (max-width: 767px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 9rem;
    }

    .gallery__item--wide,
    .gallery__item--tall {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      backdrop-filter: none;
    }
  }
</style>
