---
const base = '/images/services';

const works = [
  {
    service: 'POLARIZADO',
    title: 'Polarizado frontal',
    src: `${base}/polarizado/01.webp`,
    width: 602,
    height: 494,
    alt: 'Chevrolet negro con polarizado y visera verde, vista frontal',
    size: 'normal',
  },
  {
    service: 'POLARIZADO',
    title: 'Polarizado en Nissan',
    src: `${base}/polarizado/02.webp`,
    width: 488,
    height: 466,
    alt: 'Nissan rojo con polarizado y visera verde, vista frontal',
    size: 'normal',
  },
  {
    service: 'POLARIZADO',
    title: 'Polarizado lateral',
    src: `${base}/polarizado/03.webp`,
    width: 1098,
    height: 528,
    alt: 'SUV azul con cristales polarizados, vista lateral',
    size: 'wide',
  },
  {
    service: 'POLARIZADO',
    title: 'Antes / después',
    src: `${base}/polarizado/04.webp`,
    width: 538,
    height: 681,
    alt: 'Antes y después del polarizado en un sedán blanco',
    size: 'tall',
  },
  {
    service: 'POLARIZADO',
    title: 'Polarizado deportivo',
    src: `${base}/polarizado/05.webp`,
    width: 830,
    height: 445,
    alt: 'Auto rojo con cristales polarizados, vista lateral',
    size: 'wide',
  },
  {
    service: 'FULL WRAP',
    title: 'Wrap en moto',
    src: `${base}/full-wrap/01.webp`,
    width: 1200,
    height: 1200,
    alt: 'Antes y después del full wrap en una motocicleta',
    size: 'wide',
  },
  {
    service: 'FULL WRAP',
    title: 'Wrap en SUV',
    src: `${base}/full-wrap/02.webp`,
    width: 1200,
    height: 1200,
    alt: 'Antes y después del full wrap en una SUV',
    size: 'normal',
  },
  {
    service: 'FULL WRAP',
    title: 'Wrap en tres ángulos',
    src: `${base}/full-wrap/03.webp`,
    width: 604,
    height: 596,
    alt: 'Collage de un auto con diferentes acabados de wrap',
    size: 'tall',
  },
  {
    service: 'FULL WRAP',
    title: 'Wrap lila',
    src: `${base}/full-wrap/04.webp`,
    width: 499,
    height: 508,
    alt: 'Audi SUV con full wrap en tono lila',
    size: 'normal',
  },
  {
    service: 'FULL WRAP',
    title: 'Wrap proyecto especial',
    src: `${base}/full-wrap/05.webp`,
    width: 677,
    height: 675,
    alt: 'Antes y después del full wrap en un vehículo pequeño',
    size: 'normal',
  },
];
---

<section id="galeria" class="section gallery" aria-labelledby="galeria-title">
  <div class="container">
    <div class="section-head neon-ignite" data-reveal>
      <p class="eyebrow">GALERÍA // MURO</p>
      <h2 id="galeria-title">EL MURO DE LOS TRABAJOS</h2>
      <p>
        Polarizado y full wrap reales. Las fotos de los demás servicios se suman
        cuando el cliente las entregue.
      </p>
    </div>

    <!-- TODO: sumar fotos de los servicios restantes cuando el cliente las entregue -->
    <ul class="gallery__grid">
      {works.map((work) => (
        <li class:list={['gallery__item', `gallery__item--${work.size}`]}>
          <button
            class="gallery__button"
            type="button"
            data-gallery-item
            data-gallery-title={work.title}
            data-gallery-src={work.src}
            data-gallery-alt={work.alt}
          >
            <span class="gallery__visual">
              <img
                src={work.src}
                alt=""
                width={work.width}
                height={work.height}
                loading="lazy"
                decoding="async"
              />
              <span class="gallery__tag mono">FOTO REAL</span>
            </span>
            <span class="gallery__caption">
              <span class="mono">{work.service}</span>
              <strong>{work.title}</strong>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <p class="gallery__note mono">
      POLARIZADO + FULL WRAP // FOTOS REALES
    </p>
  </div>

  <div class="lightbox" data-lightbox hidden>
    <div class="lightbox__dialog" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
      <button
        class="lightbox__close"
        type="button"
        data-lightbox-close
        aria-label="Cerrar galería"
      >
        <span aria-hidden="true">x</span>
      </button>

      <div class="lightbox__visual">
        <img data-lightbox-image alt="" />
      </div>

      <h3 id="lightbox-title" data-lightbox-title>Trabajo en proceso</h3>

      <div class="lightbox__nav">
        <button type="button" data-lightbox-prev>Anterior</button>
        <button type="button" data-lightbox-next>Siguiente</button>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/lightbox';
</script>

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 10rem;
    grid-auto-flow: dense;
    gap: var(--space-3);
  }

  .gallery__item--wide {
    grid-column: span 2;
  }

  .gallery__item--tall {
    grid-row: span 2;
  }

  .gallery__button {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
    text-align: left;
    clip-path: var(--clip-corner-sm);
    transition:
      border-color var(--dur-fast),
      box-shadow var(--dur-fast);
  }

  .gallery__button:hover,
  .gallery__button:focus-visible {
    border-color: var(--neon-magenta);
    box-shadow: 0 0 22px color-mix(in srgb, var(--neon-magenta) 28%, transparent);
  }

  .gallery__visual {
    position: relative;
    flex: 1;
    min-height: 6rem;
    overflow: hidden;
    background: var(--bg);
  }

  .gallery__visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-snap);
  }

  .gallery__button:hover .gallery__visual img {
    transform: scale(1.04);
  }

  .gallery__tag {
    position: absolute;
    bottom: var(--space-2);
    left: var(--space-2);
    z-index: 1;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg) 74%, transparent);
    color: var(--neon-acid);
    font-size: 0.55rem;
  }

  .gallery__caption {
    display: grid;
    gap: 0.1rem;
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--line);
  }

  .gallery__caption .mono {
    color: var(--text-dim);
    font-size: 0.55rem;
  }

  .gallery__caption strong {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .gallery__note {
    margin-top: var(--space-4);
    color: var(--text-dim);
    font-size: 0.62rem;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: grid;
    place-items: center;
    padding: var(--space-4);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__dialog {
    position: relative;
    width: min(100%, 46rem);
    padding: var(--space-6);
    border: 1px solid var(--neon-magenta);
    background: var(--bg-raised);
    box-shadow: var(--glow-box-magenta);
    clip-path: var(--clip-corner);
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    z-index: 2;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1rem;
    text-transform: uppercase;
  }

  .lightbox__close:hover,
  .lightbox__close:focus-visible {
    border-color: var(--neon-magenta);
    color: var(--neon-magenta);
  }

  .lightbox__visual {
    display: grid;
    place-items: center;
    min-height: 12rem;
    max-height: 70vh;
    margin-bottom: var(--space-4);
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: var(--bg);
  }

  .lightbox__visual img {
    display: block;
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
  }

  .lightbox__dialog h3 {
    font-size: var(--fs-h3);
  }

  .lightbox__nav {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .lightbox__nav button {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .lightbox__nav button:hover,
  .lightbox__nav button:focus-visible {
    border-color: var(--neon-cyan);
    color: var(--neon-cyan);
  }

  @media (max-width: 767px) {
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 9rem;
    }

    .gallery__item--wide,
    .gallery__item--tall {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      backdrop-filter: none;
    }

    .gallery__visual img,
    .gallery__button:hover .gallery__visual img {
      transition: none;
      transform: none;
    }
  }
</style>
