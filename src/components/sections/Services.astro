---
import ServiceIcon from '../svg/ServiceIcon.astro';
import { services } from '../../data/services';

const wideIds = new Set(['calcomanias']);
---

<section id="servicios" class="section services" aria-labelledby="servicios-title">
  <div class="container">
    <div class="section-head neon-ignite" data-reveal>
      <p class="eyebrow">SERVICIOS</p>
      <h2 id="servicios-title">TODO LO QUE TU MÁQUINA NECESITA</h2>
      <p>
        Ocho servicios, ocho formas de dejar tu huella. Elige uno o combínalos:
        aquí no hay look genérico.
      </p>
    </div>

    <ul class="services__grid">
      {services.map((service) => (
        <li
          class:list={[
            'service-card',
            'animated-border',
            'tilt',
            {
              'service-card--featured': service.featured,
              'service-card--wide': wideIds.has(service.id),
            },
          ]}
          style={`--c: ${service.neon}`}
          data-tilt
        >
          <div class="service-card__inner">
            <span class="service-card__icon">
              <ServiceIcon name={service.icon} />
            </span>

            <h3>{service.name}</h3>
            <p>{service.description}</p>

            {service.featured && (
              <span class="service-card__tag mono">LOOK COMPLETO</span>
            )}
          </div>
        </li>
      ))}
    </ul>

    <p class="services__note">
      ¿No sabes cuál te conviene?
      <a href="#contacto">Te tiramos paro en el taller.</a>
    </p>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(var(--space-3), 1.6vw, var(--space-4));
  }

  .service-card {
    position: relative;
    overflow: hidden;
    min-height: 13.5rem;
    border: 1px solid color-mix(in srgb, var(--c) 34%, var(--line));
    background: var(--bg-raised);
    clip-path: var(--clip-corner-sm);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--c) 18%, transparent),
      0 0 24px color-mix(in srgb, var(--c) 16%, transparent);
    transition: box-shadow var(--dur-base) var(--ease-snap);
  }

  .service-card:hover {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--c) 55%, transparent),
      0 0 34px color-mix(in srgb, var(--c) 32%, transparent);
  }

  .service-card__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 100%;
    padding: var(--space-5, 1.25rem);
  }

  .service-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    margin-bottom: auto;
    color: var(--c);
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--c) 60%, transparent));
  }

  .service-card h3 {
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .service-card p {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .service-card__tag {
    align-self: flex-start;
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 1px solid color-mix(in srgb, var(--c) 65%, transparent);
    color: var(--c);
    font-size: 0.6rem;
  }

  .service-card--featured {
    grid-column: span 2;
    grid-row: span 2;
    border-color: color-mix(in srgb, var(--c) 70%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--c) 45%, transparent),
      0 0 44px color-mix(in srgb, var(--c) 28%, transparent);
  }

  .service-card--featured .service-card__icon {
    width: 4.6rem;
    height: 4.6rem;
  }

  .service-card--featured h3 {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }

  .service-card--featured p {
    max-width: 34ch;
    font-size: 1rem;
  }

  .service-card--wide {
    grid-column: span 2;
  }

  .services__note {
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-dim);
  }

  .services__note a {
    color: var(--neon-cyan);
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 1023px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    .service-card--featured,
    .service-card--wide {
      grid-column: span 1;
      grid-row: span 1;
    }

    .service-card {
      min-height: auto;
    }
  }
</style>
