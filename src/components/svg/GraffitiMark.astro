---
interface Props {
  text?: string;
  class?: string;
}

const { text = 'MUNDO BIKER', class: className } = Astro.props;
---

<div class:list={['graffiti-mark', className]}>
  <span class="graffiti-mark__text graffiti">{text}</span>
  <svg class="graffiti-mark__line" viewBox="0 0 220 18" fill="none" aria-hidden="true">
    <path d="M3 12c40-8 80 4 120-2s60-6 94 3" />
    <path d="m190 4 8 2-6 6" />
  </svg>
</div>

<style>
  .graffiti-mark {
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--neon-magenta);
  }

  .graffiti-mark__text {
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    text-shadow: var(--glow-text-magenta);
  }

  .graffiti-mark__line {
    width: 100%;
    height: 0.8rem;
    stroke: var(--neon-acid);
    stroke-width: 2;
    stroke-linecap: round;
    filter: drop-shadow(0 0 4px var(--neon-acid));
  }
</style>
